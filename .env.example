# Application Configuration
ENVIRONMENT=development
DEBUG=true

# Database
# Development (SQLite)
DATABASE_URL=sqlite:///./bufferiq.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://bufferiq:your_password@localhost:5432/bufferiq

# Docker PostgreSQL (when using docker-compose)
# DATABASE_URL=postgresql://bufferiq:bufferiq_dev_password@postgres:5432/bufferiq

# PostgreSQL Connection Details (for scripts)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bufferiq
POSTGRES_PASSWORD=bufferiq_dev_password
POSTGRES_DB=bufferiq

# Cache
# Local Redis
REDIS_URL=redis://localhost:6379/0

# Docker Redis (when using docker-compose)
# REDIS_URL=redis://redis:6379/0

# Buffer API
BUFFER_API_URL=https://graph.buffer.com/graphql
BUFFER_API_KEY=your_buffer_api_key_here

# ML Models
MODEL_PATH=./models

# Logging
LOG_LEVEL=INFO

# Buffer API Rate Limits (Free Tier)
MAX_REQUESTS_PER_15MIN=100
MAX_REQUESTS_PER_24HOURS=500
MAX_REQUESTS_PER_30DAYS=999

# Sync Configuration
SYNC_BATCH_SIZE=100
SYNC_CHECKPOINT_INTERVAL=100
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=5
